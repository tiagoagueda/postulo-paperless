#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Një fushë URL në çdo dokument që të çon përsëri në aplikativ këtu, e krijuar në mungesë të fletës. Lëre të zbrazët për asnjë."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "Sinj"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "Fusha e personalizuar për lidhjen e aplikativit"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Nga profili yt pa letra. I shifruar; asnjëherë më."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "Jep të gjithë adresën, duke filluar me https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "Adresa pa letra"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Pa letër u përgjigj me më shumë se ky plugin lexon, ose shumë ngadalë."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "Pa letra e konsumoi dokumentin por nuk dha asnjë ID."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Pa titull nuk"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Pa fletë akoma është duke konsumuar dokumentin; ai do të kontrollohet përsëri."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Pa kusht nuk pranon më simbolin API ([X43XX]). Shto a në."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless-ngx"
msgstr "Fx pa fletë"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Vendos çdo dokument që vjen nga Populo. Mos lër asgjë bosh."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "E arritshme. Arkivi përmban dokumentin %(count)d."
msgstr[1] "E arritshme. Arkivi përmban dokumente %(count)d."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Tag"
msgstr "Tag"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Kjo do t'i dërgojë stemën tuaj API të pakriptuar një serveri në internet, ku çdo gjë gjatë rrugës mund ta lexojë atë. Përdor https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Aty ku hap fletë pa kusht, e.g. https://tonless.example.org."
