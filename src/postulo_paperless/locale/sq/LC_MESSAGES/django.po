#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Një fushë URL në çdo dokument që të çon te aplikimi këtu, e krijuar në Paperless nëse mungon. Lëreni bosh për asnjë."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "Token API"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Fusha e personalizuar për lidhjen e aplikimit"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Nga profili juaj në Paperless. Ruhet i enkriptuar; nuk shfaqet më kurrë."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Jepni të gjithë adresën, duke filluar me https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Adresa e Paperless"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless u përgjigj me më shumë se sa lexon kjo shtojcë, ose tepër ngadalë."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless e përpunoi dokumentin, por nuk dha asnjë ID."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless nuk mundi ta përpunonte dokumentin: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless po e përpunon ende dokumentin; do të kontrollohet sërish."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless nuk e pranon më tokenin API (%(reason)s). Jepni një të vlefshëm, pastaj aktivizojeni sërish lidhjen."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Vendoset në çdo dokument që erdhi nga Postulo. Lëreni bosh për asnjë."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "E arritshme. Arkivi përmban %(count)d dokument."
msgstr[1] "E arritshme. Arkivi përmban %(count)d dokumente."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etiketë"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Kjo do ta dërgonte tokenin tuaj API të paenkriptuar te një server në internet, ku çdo gjë gjatë rrugës mund ta lexojë. Përdorni https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Aty ku hapni Paperless, p.sh. https://paperless.example.org."
