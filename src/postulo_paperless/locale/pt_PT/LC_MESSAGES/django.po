#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Um campo URL em cada documento que leva de volta à candidatura aqui, criado no Paperless se faltar. Deixe em branco para nenhum."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "Token de API"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Campo personalizado para a ligação da candidatura"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Do seu perfil no Paperless. Guardado cifrado; nunca volta a ser mostrado."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Indique o endereço completo, a começar por https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Endereço do Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless respondeu com mais do que este plugin lê, ou muito lentamente."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "O Paperless consumiu o documento mas não devolveu nenhum identificador."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "O Paperless não conseguiu consumir o documento: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "O Paperless ainda está a consumir o documento; será verificado de novo."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless não aceita mais o token API (%(reason)s). Digite um atual e, em seguida, ligue a conexão novamente."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Posta em cada documento vindo do Postulo. Deixe em branco para nenhuma."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Atingível. O arquivo contém documento %(count)d."
msgstr[1] "Atingível. O arquivo contém documentos %(count)d."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etiqueta"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Isto enviaria o seu token de API sem cifra para um servidor na Internet, onde qualquer coisa pelo caminho o pode ler. Use https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Onde abre o Paperless, p. ex. https://paperless.example.org."
