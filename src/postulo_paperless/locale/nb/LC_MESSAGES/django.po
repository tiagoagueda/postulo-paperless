#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Et URL-felt på hvert dokument som lenker tilbake til søknaden her, og som opprettes i Paperless hvis det mangler. La stå tomt for ingen."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API-token"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Egendefinert felt for lenken til søknaden"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Fra Paperless-profilen din. Lagres kryptert og vises aldri igjen."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Oppgi hele adressen, som begynner med https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless-adresse"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless svarte med mer enn dette programtillegget leser, eller for tregt."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless tok imot dokumentet, men oppga ingen ID."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless kunne ikke ta imot dokumentet: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless behandler fortsatt dokumentet; det blir sjekket igjen."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless godtar ikke lenger API-tokenet (%(reason)s). Skriv inn et gyldig token, og slå deretter tilkoblingen på igjen."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Settes på hvert dokument som kom fra Postulo. La stå tomt for ingen."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Tilgjengelig. Arkivet inneholder %(count)d dokument."
msgstr[1] "Tilgjengelig. Arkivet inneholder %(count)d dokumenter."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etikett"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Dette ville sendt API-tokenet ditt ukryptert til en server på internett, der hvem som helst underveis kan lese det. Bruk https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Der du åpner Paperless, f.eks. https://paperless.example.org."
