#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Un campo URL en cada documento que lleva de vuelta a la postulación aquí; se crea en Paperless si falta. Déjalo en blanco para ninguno."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "Token de API"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Campo personalizado para el enlace de la postulación"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "De tu perfil de Paperless. Se guarda cifrado; no se vuelve a mostrar."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Escribe la dirección completa, empezando por https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Dirección de Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Respuesta sin papel con más de lo que este plugin lee, o demasiado lentamente."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless procesó el documento pero no devolvió ningún ID."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless no pudo procesar el documento: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless todavía está procesando el documento; se volverá a comprobar."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless ya no acepta el token de API (%(reason)s). Ingrese una corriente, luego cambie la conexión de nuevo."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Se agrega a cada documento que proviene de Postulo. Déjalo en blanco para ninguno."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Es posible. El archivo contiene %(count)d documento."
msgstr[1] "Es posible. El archivo contiene %(count)d documentos."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etiqueta"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Esto enviaría tu token de API sin cifrar a un servidor en internet, donde cualquiera en el camino podría leerlo. Usa https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Donde abres Paperless, p. ej. https://paperless.example.org."
