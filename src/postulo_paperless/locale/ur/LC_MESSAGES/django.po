#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "ہر دستاویز پر ایک ادائیگی کا میدان جو یہاں درخواست کی طرف رجوع کرتا ہے، اگر گم شدہ نہ ہو تو کاغذی کرنسی میں بنایا گیا ہے. کسی کو پریشان نہ کریں ۔."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "علامات"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "اطلاقیہ لنک کے لیے متعلقه میدان"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "آپ کی کاغذی پرفارم سے. دوبارہ کبھی نظر نہیں آتا ۔."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "پورا پتہ دے، شروع https://s://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "کاغذی پتہ"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "اس پلگن سے زیادہ جواب دینے والا کاغذی جواب یا بہت آہستہ ہوتا ہے۔."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "کاغذی کرنسی کھا لی لیکن کوئی شناخت نہیں دی۔."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "کاغذی کرنسی نہیں کھا سکتی تھی"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "کاغذی کرنسی ابھی تک کھا رہی ہے؛ پھر سے چیک کیا جائے گا۔."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "کاغذ کے بغیر اب اے پی آئی کی نشان دہی (X43X) کو تسلیم نہیں کیا جا سکتا۔ حالیہ ایکشن داخل کریں، پھر دوبارہ اتصال کو تبدیل کریں."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless-ngx"
msgstr "غیر متصل"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "پوسٹلو سے آنے والی ہر دستاویز پر رکھیں۔ کسی کو پریشان نہ کریں ۔."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "دستیاب. محفوظہ %(count)d دستاویز رکھتی ہے."
msgstr[1] "دستیاب. محفوظہ %(count)d دستاویز رکھتا ہے."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Tag"
msgstr "ٹیگ"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "یہ آپ کے اے پی آئی انٹرنیٹ پر ایک سرور کے پاس نشان بھیج دیں گے، جہاں راستے سے کوئی بھی چیز اسے پڑھ سکتی ہے۔ ایس ."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "جہاں آپ کھلے کاغذ کے بغیر، مثلاً https://ppersless.expal.org."
