#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "ہر دستاویز پر ایک URL خانہ جو یہاں کی درخواست تک واپس لے جاتا ہے، اگر موجود نہ ہو تو Paperless میں بنایا جاتا ہے۔ کچھ نہ چاہیں تو خالی چھوڑ دیں۔"

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API ٹوکن"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "درخواست کے لنک کے لیے حسبِ ضرورت خانہ"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "آپ کی Paperless پروفائل سے۔ انکرپٹ کر کے محفوظ کیا جاتا ہے؛ دوبارہ کبھی نہیں دکھایا جاتا۔"

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "پورا پتہ دیں، https:// سے شروع کرتے ہوئے۔"

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless کا پتہ"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless نے اس سے زیادہ جواب دیا جتنا یہ پلگ ان پڑھتا ہے، یا بہت آہستہ جواب دیا۔"

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless نے دستاویز پراسیس کر لی لیکن کوئی id نہیں دی۔"

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless دستاویز کو پراسیس نہیں کر سکا: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless ابھی دستاویز پراسیس کر رہا ہے؛ اسے دوبارہ چیک کیا جائے گا۔"

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless اب API ٹوکن قبول نہیں کرتا (%(reason)s)۔ ایک موجودہ ٹوکن درج کریں، پھر کنکشن دوبارہ آن کریں۔"

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Postulo سے آنے والی ہر دستاویز پر لگایا جاتا ہے۔ کچھ نہ چاہیں تو خالی چھوڑ دیں۔"

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "قابلِ رسائی۔ آرکائیو میں %(count)d دستاویز ہے۔"
msgstr[1] "قابلِ رسائی۔ آرکائیو میں %(count)d دستاویزات ہیں۔"

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "ٹیگ"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "اس سے آپ کا API ٹوکن بغیر انکرپشن کے انٹرنیٹ پر کسی سرور کو بھیجا جائے گا، جہاں راستے میں کوئی بھی اسے پڑھ سکتا ہے۔ https:// استعمال کریں۔"

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "جہاں آپ Paperless کھولتے ہیں، مثلاً https://paperless.example.org۔"
