#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Her belgede, buradaki başvuruya geri götüren bir URL alanı; yoksa Paperless'ta oluşturulur. Hiçbiri için boş bırakın."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API belirteci"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Başvuru bağlantısı için özel alan"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Paperless profilinizden alınır. Şifrelenmiş olarak saklanır; bir daha gösterilmez."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "https:// ile başlayan adresin tamamını girin."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless adresi"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless, bu eklentinin okuduğundan fazlasıyla ya da çok yavaş yanıt verdi."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless belgeyi işledi ama bir kimlik vermedi."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless belgeyi işleyemedi: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless belgeyi hâlâ işliyor; yeniden kontrol edilecek."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless artık API belirtecini kabul etmiyor (%(reason)s). Geçerli bir belirteç girin, ardından bağlantıyı yeniden açın."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Postulo'dan gelen her belgeye eklenir. Hiçbiri için boş bırakın."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Ulaşılabilir. Arşivde %(count)d belge var."
msgstr[1] "Ulaşılabilir. Arşivde %(count)d belge var."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etiket"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Bu, API belirtecinizi internetteki bir sunucuya şifrelenmeden gönderirdi; yol üzerindeki herhangi biri onu okuyabilir. https:// kullanın."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Paperless'ı açtığınız adres, ör. https://paperless.example.org."
