#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Kiekvieno dokumento URL laukas, vedantis atgal į paraišką Postulo programoje; jei jo nėra, jis sukuriamas Paperless. Palikite tuščią, jei nereikia."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API žetonas"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Pasirinktinis laukas paraiškos nuorodai"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Iš jūsų Paperless profilio. Saugomas užšifruotas; daugiau niekada nerodomas."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Įveskite visą adresą, prasidedantį https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless adresas"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless atsakymas buvo didesnis, nei šis įskiepis nuskaito, arba per lėtas."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless apdorojo dokumentą, bet nepateikė identifikatoriaus."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless nepavyko apdoroti dokumento: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless vis dar apdoroja dokumentą; bus patikrinta dar kartą."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless nebepriima API rakto (%(reason)s). Įveskite galiojantį raktą ir vėl įjunkite ryšį."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Priskiriama kiekvienam iš Postulo gautam dokumentui. Palikite tuščią, jei nereikia."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Pasiekiama. Archyve yra %(count)d dokumentas."
msgstr[1] "Pasiekiama. Archyve yra %(count)d dokumentai."
msgstr[2] "Pasiekiama. Archyve yra %(count)d dokumentų."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Žyma"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Taip jūsų API žetonas būtų siunčiamas neužšifruotas į serverį internete, kur pakeliui jį gali perskaityti bet kas. Naudokite https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Adresas, kuriuo atidarote Paperless, pvz., https://paperless.example.org."
