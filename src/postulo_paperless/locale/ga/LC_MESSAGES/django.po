#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Réimse URL ar gach doiciméad a threoraíonn ar ais chuig an iarratas anseo, cruthaithe in Paperless mura bhfuil sé ann. Fág bán mura dteastaíonn ceann."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "Comhartha API"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Réimse saincheaptha do nasc an iarratais"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Ó do phróifíl Paperless. Stóráilte go criptithe; ní thaispeántar arís é go deo."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Tabhair an seoladh iomlán, ag tosú le https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Seoladh Paperless"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "D’fhreagair Paperless le níos mó ná a léann an breiseán seo, nó rómhall."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Phróiseáil Paperless an doiciméad ach níor thug sé aon aitheantas."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Níorbh fhéidir le Paperless an doiciméad a phróiseáil: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Tá Paperless fós ag próiseáil an doiciméid; seiceálfar arís é."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Ní ghlacann Paperless leis an gcomhartha API a thuilleadh (%(reason)s). Cuir isteach ceann reatha, agus ansin cuir an nasc ar siúl arís."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Cuirtear ar gach doiciméad a tháinig ó Postulo é. Fág bán mura dteastaíonn ceann."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Inrochtana. Tá %(count)d doiciméad sa chartlann."
msgstr[1] "Inrochtana. Tá %(count)d dhoiciméad sa chartlann."
msgstr[2] "Inrochtana. Tá %(count)d dhoiciméad sa chartlann."
msgstr[3] "Inrochtana. Tá %(count)d ndoiciméad sa chartlann."
msgstr[4] "Inrochtana. Tá %(count)d doiciméad sa chartlann."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Clib"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Sheolfadh sé seo do chomhartha API gan chriptiú chuig freastalaí ar an idirlíon, áit ar féidir le haon rud ar an mbealach é a léamh. Úsáid https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "An áit a n-osclaíonn tú Paperless, m.sh. https://paperless.example.org."
