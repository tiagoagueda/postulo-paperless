#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Un campo URL en cada documento que leva de volta á candidatura aquí; créase no Paperless se non existe. Déixao en branco para non usar ningún."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "Testemuño de API"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Campo personalizado para a ligazón da candidatura"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Do teu perfil de Paperless. Almacénase cifrado; nunca se volve mostrar."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Escribe o enderezo completo, comezando por https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Enderezo de Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless respondeu con máis do que este plugin leu, ou moi lentamente."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless procesou o documento pero non devolveu ningún id."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless non puido procesar o documento: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless aínda está a procesar o documento; comprobarase de novo."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Non se acepta o token API (%(reason)s). Introduza un actual e despois cambie a conexión de novo."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Engádese a cada documento que veña do Postulo. Déixao en branco para non usar ningunha."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Alcanzable. O ficheiro contén %(count)d."
msgstr[1] "Alcanzable. O ficheiro contén %(count)d."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etiqueta"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Isto enviaría o teu testemuño de API sen cifrar a un servidor en Internet, onde calquera intermediario pode lelo. Usa https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Onde abres Paperless, por exemplo, https://paperless.example.org."
