#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Kamp URL fuq kull dokument li jwassal lura għall-applikazzjoni hawn, maħluq f'Paperless jekk ma jkunx hemm. Ħalli vojt biex ma jkunx hemm."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "Token tal-API"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "Kamp personalizzat għall-link tal-applikazzjoni"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Mill-profil Paperless tiegħek. Maħżun kriptat; qatt ma jintwera iżjed."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "Agħti l-indirizz sħiħ, li jibda b'https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "Indirizz ta' Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless wieġeb b'aktar milli jaqra dan il-plugin, jew bil-mod wisq."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless ipproċessa d-dokument imma ma ta l-ebda id."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
