#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless għadu qed jipproċessa d-dokument; se jiġi ċċekkjat mill-ġdid."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless m'għadux jaċċetta t-token tal-API (%(reason)s). Daħħal wieħed kurrenti, imbagħad erġa' ixgħel il-konnessjoni."

#: src/postulo_paperless/store.py
#, fuzzy
