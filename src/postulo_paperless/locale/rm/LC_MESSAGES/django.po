#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "In champ URL sin mintga document che maina enavos a la candidatura qua, creà en Paperless sch'el manca. Laschai vid per nagin."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "Token d'API"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "Champ persunalisà per la colliaziun da la candidatura"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Da Voss profil Paperless. Memorisà criptà; mai pli mussà."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "Indicai l'adressa cumpletta, cumenzond cun https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "Adressa da Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless ha respundì cun dapli che quest plugin legia, u memia plaun."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless ha elavurà il document, ma n'ha dà nagin id."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless n'ha betg pudì elavurar il document: %(reason)s"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless elavura anc il document; el vegn verifitgà anc ina giada."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless n'accepta betg pli il token d'API (%(reason)s). Endatai in actual, ed activai lura danovamain la connexiun."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Mess sin mintga document che deriva da Postulo. Laschai vid per nagin."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Cuntanschibel. L'archiv cuntegna %(count)d document."
msgstr[1] "Cuntanschibel. L'archiv cuntegna %(count)d documents."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Tag"
msgstr "Etichetta"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Quai tramettess Voss token d'API betg criptà ad in server en l'internet, nua che tut sin la via al po leger. Utilisai https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Nua che Vus avris Paperless, p.ex. https://paperless.example.org."
