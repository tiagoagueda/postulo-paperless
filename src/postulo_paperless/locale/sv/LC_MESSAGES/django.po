#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Ett URL-fält på varje dokument som leder tillbaka till ansökan här, skapas i Paperless om det saknas. Lämna tomt för inget."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API-token"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Anpassat fält för ansökans länk"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Från din Paperless-profil. Sparas krypterat; visas aldrig igen."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Ange hela adressen, med början på https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless-adress"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless svarade med mer än det här tillägget läser, eller för långsamt."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless tog emot dokumentet men gav inget id."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless kunde inte ta emot dokumentet: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless bearbetar fortfarande dokumentet; det kontrolleras igen."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless godkänner inte längre API-token (%(reason)s). Ange en giltig och slå sedan på anslutningen igen."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Sätts på varje dokument som kom från Postulo. Lämna tomt för ingen."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Går att nå. Arkivet innehåller %(count)d dokument."
msgstr[1] "Går att nå. Arkivet innehåller %(count)d dokument."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Tagg"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Detta skulle skicka din API-token okrypterad till en server på internet, där vad som helst längs vägen kan läsa den. Använd https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Där du öppnar Paperless, t.ex. https://paperless.example.org."
