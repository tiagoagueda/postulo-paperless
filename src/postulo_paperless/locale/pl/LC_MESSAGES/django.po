#: src/postulo_paperless/store.py:228
#, draft
msgid ""
"A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr ""
"Pole URL na każdym dokumencie prowadzące z powrotem do aplikacji tutaj, tworzone w Paperless, jeśli go brakuje. Zostaw puste, aby nie używać."

#: src/postulo_paperless/store.py:208
#, draft
msgid "API token"
msgstr "Token API"

#: src/postulo_paperless/store.py:223
#, draft
msgid "Custom field for the application's link"
msgstr "Pole niestandardowe na link do aplikacji"

#: src/postulo_paperless/store.py:211
#, draft
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr ""
"Z Twojego profilu Paperless. Przechowywany w postaci zaszyfrowanej; nigdy nie jest pokazywany ponownie."

#: src/postulo_paperless/store.py:202
#, draft
msgid "Paperless address"
msgstr "Adres Paperless"

#: src/postulo_paperless/store.py:156
#, draft
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless przetworzył dokument, ale nie podał identyfikatora."

#: src/postulo_paperless/store.py:165
#, python-format, draft
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless nie mógł przetworzyć dokumentu: %(reason)s"

#: src/postulo_paperless/store.py:170
#, draft
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless wciąż przetwarza dokument; zostanie sprawdzony ponownie."

#: src/postulo_paperless/store.py:196
#, draft
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py:219
#, draft
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr ""
"Nadawany każdemu dokumentowi, który pochodzi z Postulo. Zostaw puste, aby nie używać."

#: src/postulo_paperless/store.py:249
#, python-format, draft
msgid "Reachable. The archive holds %(count)d documents."
msgstr "Osiągalny. Archiwum zawiera %(count)d dokumentów."

#: src/postulo_paperless/store.py:215
#, draft
msgid "Tag"
msgstr "Tag"

#: src/postulo_paperless/store.py:204
#, draft
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Tam, gdzie otwierasz Paperless, np. https://paperless.example.org."
