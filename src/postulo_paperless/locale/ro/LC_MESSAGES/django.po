#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Un câmp URL pe fiecare document care duce înapoi la candidatura de aici, creat în Paperless dacă lipsește. Lăsați gol pentru niciunul."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "Token API"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Câmp personalizat pentru linkul candidaturii"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Din profilul dumneavoastră Paperless. Stocat criptat; nu mai este afișat niciodată."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Introduceți adresa completă, care începe cu https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Adresa Paperless"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless a răspuns cu mai mult decât citește acest plugin sau prea lent."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless a preluat documentul, dar nu a returnat niciun id."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless nu a putut prelua documentul: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless încă procesează documentul; va fi verificat din nou."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless nu mai acceptă tokenul API (%(reason)s). Introduceți unul valabil, apoi reactivați conexiunea."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Aplicată pe fiecare document venit de la Postulo. Lăsați gol pentru niciuna."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Accesibil. Arhiva conține %(count)d document."
msgstr[1] "Accesibil. Arhiva conține %(count)d documente."
msgstr[2] "Accesibil. Arhiva conține %(count)d de documente."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etichetă"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Astfel, tokenul dumneavoastră API ar fi trimis necriptat către un server de pe internet, unde îl poate citi oricine se află pe traseu. Folosiți https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Adresa la care deschideți Paperless, de ex. https://paperless.example.org."
