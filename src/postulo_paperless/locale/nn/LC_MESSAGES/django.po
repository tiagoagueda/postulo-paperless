#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Eit URL-felt på kvart dokument som leier tilbake til søknaden her, oppretta i Paperless om det manglar. La stå tomt for ingen."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "API-token"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "Eigendefinert felt for lenkja til søknaden"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Frå Paperless-profilen din. Lagra kryptert; blir aldri vist igjen."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "Oppgi heile adressa, med https:// først."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "Paperless-adresse"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless svarte med meir enn dette tillegget les, eller for tregt."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless tok inn dokumentet, men gav ingen ID."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless kunne ikkje ta inn dokumentet: %(reason)s"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless held framleis på å ta inn dokumentet; det blir sjekka igjen."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless godtek ikkje lenger API-tokenet (%(reason)s). Skriv inn eit gyldig, og slå så på tilkoplinga igjen."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Blir sett på kvart dokument som kom frå Postulo. La stå tomt for ingen."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Kan nåast. Arkivet inneheld %(count)d dokument."
msgstr[1] "Kan nåast. Arkivet inneheld %(count)d dokument."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Tag"
msgstr "Etikett"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Dette ville sende API-tokenet ditt ukryptert til ein tenar på internett, der alt på vegen kan lese det. Bruk https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Der du opnar Paperless, t.d. https://paperless.example.org."
