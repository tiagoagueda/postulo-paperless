#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Kolom URL pada setiap dokumen yang menautkan kembali ke lamaran di sini, dibuat di Paperless jika belum ada. Kosongkan jika tidak perlu."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "Token API"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Kolom kustom untuk tautan lamaran"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Dari profil Paperless Anda. Disimpan terenkripsi; tidak pernah ditampilkan lagi."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Berikan alamat lengkap, diawali dengan https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Alamat Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Berkas menjawab dengan lebih dari plugin ini membaca, atau terlalu lambat."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless sudah memproses dokumen tetapi tidak memberikan ID."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless tidak dapat memproses dokumen: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless masih memproses dokumen; dokumen akan diperiksa lagi."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Tidak ada kertas lagi yang menerima token API (%(reason)s). Masukkan yang kini, lalu nyalakan koneksi lagi."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Diberikan pada setiap dokumen yang berasal dari Postulo. Kosongkan jika tidak perlu."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Dapat. Arsip menyimpan %(count)d dokumen."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Tag"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Ini akan mengirim token API Anda tanpa enkripsi ke server di internet, tempat siapa pun di sepanjang jalur dapat membacanya. Gunakan https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Tempat Anda membuka Paperless, misalnya https://paperless.example.org."
