#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Dokumentu bakoitzean URL eremu bat, hemengo hautagaitzara itzultzeko esteka duena; Paperless-en sortzen da ez badago. Utzi hutsik, bat ere ez izateko."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API tokena"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Hautagaitzaren estekarako eremu pertsonalizatua"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Zure Paperless profiletik. Zifratuta gordetzen da; ez da berriro erakusten."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Eman helbide osoa, https:// aurrizkiarekin hasita."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless-en helbidea"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless-ek plugin honek irakurtzen duena baino gehiagorekin erantzun du, edo motelegi."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless-ek dokumentua kontsumitu du, baina ez du IDrik eman."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless-ek ezin izan du dokumentua kontsumitu: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless-ek dokumentua kontsumitzen jarraitzen du; berriro egiaztatuko da."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless-ek jada ez du API tokena onartzen (%(reason)s). Sartu baliozko bat, eta piztu konexioa berriro."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Postulotik datorren dokumentu orotan jartzen da. Utzi hutsik, bat ere ez jartzeko."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Eskuragarri. Artxiboak dokumentu bat dauka."
msgstr[1] "Eskuragarri. Artxiboak %(count)d dokumentu ditu."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Etiketa"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Honek zure API tokena zifratu gabe bidaliko luke Interneteko zerbitzari batera, eta bidean dagoen edozerk irakur lezake. Erabili https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Paperless irekitzeko helbidea; adibidez, https://paperless.example.org."
