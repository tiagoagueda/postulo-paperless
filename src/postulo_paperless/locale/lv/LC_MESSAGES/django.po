#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "URL lauks katrā dokumentā, kas ved atpakaļ uz šeit esošo pieteikumu; ja tāda nav, tas tiek izveidots Paperless. Atstājiet tukšu, ja tas nav vajadzīgs."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API marķieris"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Pielāgots lauks pieteikuma saitei"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "No jūsu Paperless profila. Glabāts šifrēti; vairs nekad netiek rādīts."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Norādiet visu adresi, sākot ar https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless adrese"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless atbildēja ar vairāk datu, nekā šis spraudnis nolasa, vai pārāk lēni."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless apstrādāja dokumentu, bet nedeva id."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless nevarēja apstrādāt dokumentu: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless joprojām apstrādā dokumentu; tas tiks pārbaudīts vēlreiz."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless vairs nepieņem API marķieri (%(reason)s). Ievadiet derīgu marķieri un pēc tam atkal ieslēdziet savienojumu."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Tiek pievienota katram dokumentam, kas nācis no Postulo. Atstājiet tukšu, ja tā nav vajadzīga."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Sasniedzams. Arhīvā ir %(count)d dokuments."
msgstr[1] "Sasniedzams. Arhīvā ir %(count)d dokumenti."
msgstr[2] "Sasniedzams. Arhīvā ir %(count)d dokumentu."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Birka"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Tas nosūtītu jūsu API marķieri nešifrētu uz serveri internetā, kur to pa ceļam var izlasīt jebkas. Izmantojiet https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Adrese, kurā atverat Paperless, piemēram, https://paperless.example.org."
