#: src/postulo_paperless/store.py
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."

#: src/postulo_paperless/store.py
msgid "API token"
msgstr "API token"

#: src/postulo_paperless/store.py
msgid "Custom field for the application's link"
msgstr "Custom field for the application's link"

#: src/postulo_paperless/store.py
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "From your Paperless profile. Stored encrypted; never shown again."

#: src/postulo_paperless/store.py
msgid "Give the whole address, beginning with https://."
msgstr "Give the whole address, beginning with https://."

#: src/postulo_paperless/store.py
msgid "Paperless address"
msgstr "Paperless address"

#: src/postulo_paperless/store.py
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless answered with more than this plugin reads, or too slowly."

#: src/postulo_paperless/store.py
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless consumed the document but gave no id."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless could not consume the document: %(reason)s"

#: src/postulo_paperless/store.py
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless is still consuming the document; it will be checked again."

#: src/postulo_paperless/store.py
#, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."

#: src/postulo_paperless/store.py
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Put on every document that came from Postulo. Leave blank for none."

#: src/postulo_paperless/store.py
#, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Reachable. The archive holds %(count)d document."
msgstr[1] "Reachable. The archive holds %(count)d documents."

#: src/postulo_paperless/store.py
msgid "Tag"
msgstr "Tag"

#: src/postulo_paperless/store.py
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."

#: src/postulo_paperless/store.py
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Where you open Paperless, e.g. https://paperless.example.org."
