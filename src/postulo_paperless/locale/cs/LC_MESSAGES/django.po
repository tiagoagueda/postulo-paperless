msgstr "Paperless dokument stále zpracovává; bude znovu zkontrolován."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Bezpapírový již nepřijímá symbol API (%(reason)s). Zadejte aktuální a pak znovu zapněte spojení."

#: src/postulo_paperless/store.py
#, fuzzy
