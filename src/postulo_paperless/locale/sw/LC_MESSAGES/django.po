#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Shamba la URL kwenye kila hati inayoongoza nyuma ya programu hapa, iliyoundwa katika Paperless ikiwa haipo. Acha pombe kwa ajili ya mtu yeyote."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "API ya API"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "Eneo la kawaida kwa kiungo cha maombi"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Kutoka kwa wasifu wako usio na maandishi. Picha zote na Wizara ya Mambo ya Ndani ya Nchi. ...................................................................."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "Kutoa anwani yote, kuanzia kwa https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "Anwani ya barua pepe"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Paperless alijibu kwa zaidi ya Plugin hii kusoma, au polepole sana."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "Waandishi walitumia hati hiyo lakini hawakutoa kitambulisho."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Maandishi hayawezi kutumia hati: %(reason)s"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Karatasi bado hutumia hati; itachunguzwa tena."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Bila karatasi hakuna tena kukubali ishara ya API (X43X). Kuingia moja ya sasa, kisha kubadili uhusiano tena."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless-ngx"
msgstr "Kiwango cha chini-ngx"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Andika kila barua iliyotumwa kutoka posta. Acha pombe kwa ajili ya mtu yeyote."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Ya kufikia. Nyaraka hii ina hati ya %(count)d."
msgstr[1] "Ya kufikia. Nyaraka hizo zina nyaraka (X29X)."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Tag"
msgstr "Kuwa"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Hii itatuma ishara yako ya API isiyojulikana kwenye seva kwenye mtandao, ambapo chochote njiani kinaweza kusoma. Matumizi ya https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Ambapo kufungua Paperless, kwa mfano https://paperless.example.org."
