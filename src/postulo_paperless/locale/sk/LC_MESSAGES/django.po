#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Pole URL na každom dokumente vedúce späť k žiadosti tu; ak v Paperless chýba, vytvorí sa. Ak žiadne nechcete, nechajte prázdne."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "API token"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "Vlastné pole pre odkaz na žiadosť"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "Z vášho profilu v Paperless. Uložené šifrovane; už sa nikdy nezobrazí."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "Uveďte celú adresu, počnúc https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "Adresa Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless answered with more than this plugin reads, or too slowly."
msgstr "Bezpapierové odpovede s viac ako tento plugin číta, alebo príliš pomaly."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "Paperless dokument spracoval, ale nevrátil žiadne id."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Paperless nemohol dokument spracovať: %(reason)s"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Paperless dokument ešte spracúva; skontroluje sa znova."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless no longer accepts the API token (%(reason)s). Enter a current one, then switch the connection on again."
msgstr "Bezpapierový token už neprijíma (%(reason)s). Zadajte aktuálnu, potom znovu zapnite pripojenie."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Pridá sa na každý dokument, ktorý prišiel z aplikácie Postulo. Ak žiadny nechcete, nechajte prázdne."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d document."
msgid_plural "Reachable. The archive holds %(count)d documents."
msgstr[0] "Dosiahnuteľný. Archív má %(count)d dokument."
msgstr[1] "Dosiahnuteľný. Archív má %(count)d dokumenty."
msgstr[2] "Dosiahnuteľný. Archív má %(count)d dokumenty."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Tag"
msgstr "Štítok"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "To by poslalo váš token API nešifrovaný na server na internete, kde čokoľvek na ceste môže čítať. Použite https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Kde otvárate Paperless, napr. https://paperless.example.org."
