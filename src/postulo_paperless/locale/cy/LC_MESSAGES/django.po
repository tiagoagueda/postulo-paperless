#: src/postulo_paperless/store.py
#, fuzzy
msgid "A URL field on each document leading back to the application here, created in Paperless if missing. Leave blank for none."
msgstr "Maes URL ar bob dogfen sy'n arwain yn ôl at y cais yma, wedi'i greu yn Paperless os yw ar goll. Gadewch yn wag am ddim."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "API token"
msgstr "Tocyn API"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Custom field for the application's link"
msgstr "Maes personol ar gyfer dolen y cais"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "From your Paperless profile. Stored encrypted; never shown again."
msgstr "O'ch proffil Paperless. Wedi'i storio wedi'i amgryptio; byth yn cael ei ddangos eto."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Give the whole address, beginning with https://."
msgstr "Rhowch y cyfeiriad cyfan, gan ddechrau gyda https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless address"
msgstr "Cyfeiriad Paperless"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless consumed the document but gave no id."
msgstr "Proseswyd y ddogfen gan Paperless, ond ni roddodd id."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Paperless could not consume the document: %(reason)s"
msgstr "Ni allai Paperless brosesu'r ddogfen: %(reason)s"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless is still consuming the document; it will be checked again."
msgstr "Mae Paperless yn dal i brosesu'r ddogfen; caiff ei gwirio eto."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Paperless-ngx"
msgstr "Paperless-ngx"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Put on every document that came from Postulo. Leave blank for none."
msgstr "Yn cael ei roi ar bob dogfen a ddaeth o Postulo. Gadewch yn wag am ddim."

#: src/postulo_paperless/store.py
#, fuzzy, python-format
msgid "Reachable. The archive holds %(count)d documents."
msgstr "Ar gael. Mae'r archif yn dal %(count)d dogfen."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Tag"
msgstr "Tag"

#: src/postulo_paperless/store.py
#, fuzzy
msgid "This would send your API token unencrypted to a server on the internet, where anything along the way can read it. Use https://."
msgstr "Byddai hyn yn anfon eich tocyn API heb ei amgryptio i weinydd ar y rhyngrwyd, lle gall unrhyw beth ar y ffordd ei ddarllen. Defnyddiwch https://."

#: src/postulo_paperless/store.py
#, fuzzy
msgid "Where you open Paperless, e.g. https://paperless.example.org."
msgstr "Lle rydych yn agor Paperless, e.e. https://paperless.example.org."
